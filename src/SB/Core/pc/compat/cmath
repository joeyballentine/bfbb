#ifndef BFBB_PC_COMPAT_CMATH
#define BFBB_PC_COMPAT_CMATH

// MSL puts the f-suffixed math functions in namespace std, and the game's
// sources call them that way -- std::floorf, std::sqrtf. The C++ standard
// keeps those names in the global namespace and gives std the overload set
// instead, so libstdc++ has ::floorf but no std::floorf.
//
// Importing the global names is enough to make both spellings work, and it
// does not shadow or replace anything libstdc++ already declares.
#include_next <cmath>

#include <math.h>

namespace std
{
using ::acosf;
using ::asinf;
using ::atan2f;
using ::atanf;
using ::ceilf;
using ::cosf;
using ::expf;
using ::fabsf;
using ::floorf;
using ::fmodf;
using ::log10f;
using ::logf;
using ::powf;
using ::sinf;
using ::sqrtf;
using ::tanf;
} // namespace std

#endif
