static S32 gcs_type_PICK(U8* p, U32 size)
{
    U32 end = size;
    U32 c = 0;
    if (c + 0x8 > end) // an older, shorter asset: what is there
    {
        if (c < end) gcs_zAssetPickupTable_upto(p + c, end - c);
        return 1;
    }
    gcs_zAssetPickupTable(p + c);
    c += 0x8;
    {
        U32 n = gcsRead32(p + 0x4);
        U32 fit = (end - c) / 0x14;
        for (U32 k = 0; k < n && k < fit; k++, c += 0x14)
            gcs_zAssetPickup(p + c);
        if (n > fit) return 0;
    }
    return 1;
}

