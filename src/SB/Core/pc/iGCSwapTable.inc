        for (U32 k = 0; k < n && k < fit; k++, c += 0x4)
            gcsSwap32(p + c);
        if (n > fit) return 0;
    }
    {
        U32 n = gcsRead32(p + 0x8);
        U32 fit = (end - c) / 0x20;
        for (U32 k = 0; k < n && k < fit; k++, c += 0x20)
            gcs_xAnimAssetFile(p + c);
