        U32 fit = (end - c) / 0x1C;
        for (U32 k = 0; k < n && k < fit; k++, c += 0x1C)
            gcs_xAnimAssetState(p + c);
        if (n > fit) return 0;
    }
    for (; c + 4 <= end; c += 4)
        gcsSwap32(p + c);
    return 1;
}

