# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
# ...but the PC port's build lives at the root and is not a stray text file.
!/CMakeLists.txt
*.exe

# ProDG scratch: ngccc writes <basename><pid>.i / .s into the cwd for every
# bink translation unit and does not clean them up. Root only - real .s
# sources live under src/.
/*.i
/*.s

# Analysis output
classify.json

# PC port build (CMake); see CMakeLists.txt
build-pc/

# The headless configuration, -DBFBB_RENDER_BACKEND=NULL. Worth keeping around:
# it is the only way to run rw_selftest without a GPU, and two checks once
# passed on D3D9 while failing there because they read state back out of the
# device and the null one answers 0 to everything.
build-pc-null/

# Out-of-tree librw builds. Configuring a backend on its own is the quickest
# way to find out whether it compiles at all before the shim is ready for it --
# build-librw-d3d9/ was how the D3D9 backend got checked -- and the results are
# throwaway. build-pc/ above is the one that matters.
build-librw-*/
/.claude/worktrees/
