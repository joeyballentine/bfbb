# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
# ...but the PC port's build lives at the root and is not a stray text file.
!/CMakeLists.txt
*.exe

# ProDG scratch: ngccc writes <basename><pid>.i / .s into the cwd for every
# bink translation unit and does not clean them up. Root only - real .s
# sources live under src/.
/*.i
/*.s

# Analysis output
classify.json

# PC port build (CMake); see CMakeLists.txt
build-pc/

# The port's settings file. It writes one with the defaults when it does not
# find one, and normally that lands beside the executable in build-pc/ -- but
# the working directory is searched first, so running from the repository root
# with one there leaves it here. It is per-user and never wanted in the tree;
# the defaults live in iConfig.cpp's settings table.
/config.ini

# One build directory per render backend, because they cannot share one: the
# backend is baked into the CMake cache and into librw's compile definitions, so
# switching means reconfiguring from scratch. build-pc/ above is the D3D9 one.
#
#   build-pc-null/  the headless configuration, -DBFBB_RENDER_BACKEND=NULL. It
#                   is the only way to run rw_selftest without a GPU, and two
#                   checks once passed on D3D9 while failing there because they
#                   read state back out of the device and the null one answers
#                   0 to everything.
#   build-pc-gl3/   -DBFBB_RENDER_BACKEND=GL3, on SDL3.
#   build-ci/       what .github/workflows/pc-port.yml configures, named here so
#                   that reproducing a CI failure locally does not leave a
#                   directory the tree would otherwise pick up.
build-pc-null/
build-pc-gl3/
build-pc-d3d9/
build-ci/

# Out-of-tree librw builds. Configuring a backend on its own is the quickest
# way to find out whether it compiles at all before the shim is ready for it --
# build-librw-d3d9/ was how the D3D9 backend got checked -- and the results are
# throwaway. build-pc/ above is the one that matters.
build-librw-*/
/.claude/worktrees/
# Coordinator scratch space for analysis output; never part of a build.
scratch/
